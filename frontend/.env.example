# Required for production builds. Do not commit local .env files.
VITE_API_BASE_URL=https://api.example.com

# Optional. Defaults to VITE_API_BASE_URL with ws(s) protocol and /ws suffix.
VITE_WS_URL=wss://api.example.com/ws

# Optional. Keeps the mock-only admin console out of normal production navigation.
VITE_ENABLE_ADMIN_DEMO=false

# Optional. Base origin used to resolve relative API/WebSocket URLs.
VITE_APP_ORIGIN=https://app.example.com
