SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BACKEND_HOST_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=NONE
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

POSTGRES_DB=traderhub
POSTGRES_HOST_PORT=5433
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=user_db
DB_PASSWORD=password_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=redis_password
AUTH_USER_DETAILS_CACHE_TTL=2m
AUTH_USER_LOOKUP_CACHE_TTL=10m
CONVERSATION_PARTICIPANTS_CACHE_TTL=1m
CONVERSATION_PINNED_MESSAGES_CACHE_TTL=1m
COMMUNITY_CATEGORIES_CACHE_TTL=1h
COMMUNITY_TAGS_CACHE_TTL=1h
COMMUNITY_DISCOVERY_CACHE_TTL=15s
COMMUNITY_DETAIL_CACHE_TTL=10s

JWT_ISSUER=traderhub-backend
JWT_AUDIENCE=traderhub-web
JWT_ACCESS_TOKEN_SECRET=change-me-access-token-secret-at-least-32-characters
JWT_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-at-least-32-characters
JWT_REFRESH_TOKEN_HASH_SECRET=change-me-refresh-token-hash-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=864000000

CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_DDL_AUTO=validate
HIBERNATE_FORMAT_SQL=true
FLYWAY_BASELINE_ON_MIGRATE=true

EMAIL_VERIFICATION_TOKEN_TTL=24h
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email

PASSWORD_RESET_TOKEN_TTL=15m
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

SENDGRID_ENABLED=true
SENDGRID_API_KEY=sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=TraderHub

SENDGRID_PASSWORD_RESET_SUBJECT=Reset your TraderHub password
SENDGRID_EMAIL_VERIFICATION_SUBJECT=Verify your TraderHub email
SENDGRID_LOGIN_ALERT_SUBJECT=New login to your TraderHub account
SENDGRID_PASSWORD_CHANGED_SUBJECT=Your TraderHub password was changed

OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_FIXED_DELAY_MS=500
OUTBOX_WORKER_INITIAL_DELAY_MS=1000
OUTBOX_WORKER_BATCH_SIZE=20
OUTBOX_WORKER_MAX_ATTEMPTS=10
OUTBOX_WORKER_INITIAL_RETRY_DELAY=5s
OUTBOX_WORKER_MAX_RETRY_DELAY=15m
OUTBOX_WORKER_PROCESSING_TIMEOUT=60s
OUTBOX_WORKER_SCHEDULER_POOL_SIZE=1

MARKET_SYNC_ENABLED=true
MARKET_SYNC_INITIAL_DELAY_MS=10000
MARKET_SYNC_MARKETS_DELAY_MS=1800000
MARKET_SYNC_TRENDING_DELAY_MS=3600000
MARKET_SYNC_SCHEDULER_POOL_SIZE=1
MARKET_OVERVIEW_CACHE_TTL=15s
MARKET_COIN_DETAIL_CACHE_TTL=1m

MARKET_STREAM_ENABLED=true
MARKET_STREAM_BASE_URL=wss://stream.binance.com:9443/ws
MARKET_STREAM_REST_BASE_URL=https://api.binance.com
MARKET_STREAM_INITIAL_DELAY_MS=15000
MARKET_STREAM_RECONNECT_DELAY_MS=60000
MARKET_STREAM_MAX_PAIRS=200
MARKET_STREAM_CANDLE_INTERVALS=4h,1d,1w
MARKET_STREAM_CANDLE_HISTORY_LIMIT=200
MARKET_STREAM_TICKER_CACHE_TTL=10m
MARKET_STREAM_TICKER_SYMBOLS_CACHE_TTL=5m
MARKET_STREAM_CANDLE_CACHE_TTL=8d

R2_ENABLED=true
R2_ACCOUNT_ID=cloudflare_account_id
R2_ACCESS_KEY_ID=r2_access_key_id
R2_SECRET_ACCESS_KEY=r2_secret_access_key
R2_BUCKET=r2_bucket
# Public R2 custom domain or r2.dev domain, for example: https://media.example.com
R2_PUBLIC_BASE_URL=https://media.example.com
R2_PRESIGNED_UPLOAD_TTL=10m
R2_MAX_FILE_SIZE_BYTES=26214400
R2_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,audio/mpeg,audio/ogg,application/pdf,text/plain,application/zip
